# ==============================================================================
# SALESTORM — Environment Configuration Template (.env.example)
# Copy this file to backend/.env and customize values for local development
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# MongoDB Configuration
# Default connects to local MongoDB instance. For Replica Set (if testing multi-doc transactions):
# MONGODB_URI=mongodb://127.0.0.1:27017/salestorm?replicaSet=rs0
MONGODB_URI=mongodb://127.0.0.1:27017/salestorm

# Redis Configuration (Optional / Fallback mode enabled if unavailable)
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=false

# Authentication Secrets
JWT_SECRET=salestorm_super_secure_jwt_secret_key_syscrafters_2026
JWT_EXPIRES_IN=7d

# Flash Sale & Reservation Settings
RESERVATION_TTL_SECONDS=120
DEFAULT_FLASH_SALE_STOCK=100

# Simulated Payment Parameters
PAYMENT_SUCCESS_RATE=0.95
PAYMENT_FAILURE_RATE=0.05
PAYMENT_SIMULATED_DELAY_MS=300

# Simulated Outage / Resilience Settings
ORDER_PROCESSING_DELAY_MS=0
SIMULATE_ORDER_OUTAGE_SECONDS=30

# Logging & Telemetry
LOG_LEVEL=info
